# Use host secrets or a local ignored .env; never NEXT_PUBLIC_ variables.
CLARITY_API_TOKEN=
MCP_RESOURCE_URL=https://clarity-mcp.example.com/mcp
OAUTH_ISSUER=https://your-issuer.example.com/
OAUTH_JWKS_URL=https://your-issuer.example.com/.well-known/jwks.json
# Exact subject claim of the website owner (not an email guess).
OAUTH_ALLOWED_SUBJECTS=
PORT=8787
# Optional comma-separated exact browser origins; server-to-server clients need none.
MCP_ALLOWED_ORIGINS=
